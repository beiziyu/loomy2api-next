[Unit]
Description=Loomy2API gateway (Loomy session pool -> OpenAI compatible API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# __APP_DIR__ 由 install.sh 自动替换成实际安装路径
WorkingDirectory=__APP_DIR__
Environment=LOOMY2API_CONFIG=__APP_DIR__/config.json
ExecStart=__APP_DIR__/.venv/bin/python __APP_DIR__/app.py
Restart=always
RestartSec=3
StandardOutput=append:__APP_DIR__/logs/service.log
StandardError=append:__APP_DIR__/logs/service.log

[Install]
WantedBy=multi-user.target
